      Uni.t1298(c, U32.is_lt(c, 128170))

def Uni.t1300(+c: U32, lt: Bool) -> U32:
  match lt:
    case True{}:
      Uni.t649(c, U32.is_lt(c, 7083))
    case False{}:
      Uni.t1299(c, U32.is_lt(c, 119079))

def Uni.flags(+c: U32) -> U32:
  Uni.t1300(c, U32.is_lt(c, 43713))

def Uni.has(+c: U32, f: U32) -> Bool:
  U32.is_ne(U32.and(Uni.flags(c), f), 0)
